# Copy this file to .env and fill in real values once the live fetchers are
# wired up (see each fetchers/fetch_*.py docstring for what each var feeds).
# Not required for the default sample-phase build.

# This is a standalone repo with its own credentials -- these are NOT shared
# with the Combined Marketing Dashboard or Page Quality Dashboard repos, even
# though they authenticate against the same underlying Google/GSC/GA4/Ads
# accounts (same shared OAuth client, project "erudite-coast-502112-n5", but
# fresh refresh tokens for this repo). See README.md "GSC / GA4 / Google Ads
# -- one-time OAuth setup" for the exact steps (scripts/authenticate_all.py).
# Status: set in GitHub Actions secrets (weekly batch, all six) AND in
# Vercel Environment Variables for the live Search tool's GSC + Ads
# cross-reference -- EXCEPT GA4_REFRESH_TOKEN, which is GitHub-Actions-only.
# GA4 has no native search-query dimension, so api/search.py never makes a
# live GA4 call; only the weekly batch (page-level GA4) needs it.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GA4_REFRESH_TOKEN=
GSC_REFRESH_TOKEN=

# Semrush REST API key (separate from the Semrush MCP connection used
# interactively in Claude Code -- that connection cannot be called from a
# headless GitHub Actions script). Find it at semrush.com -> profile menu ->
# Subscription info -> https://www.semrush.com/subscription-info/api-units/
# Status: set in both GitHub Actions secrets and Vercel Environment
# Variables (the live Search tool at api/search.py needs it in Vercel
# specifically; the weekly batch needs it in GitHub Actions).
SEMRUSH_API_KEY=

# Claude API key for the live Search tool's AI keyword ideation
# (analysis/ai_keyword_ideation.py) -- separate from any Claude Code/
# Claude.ai subscription; this is pay-as-you-go API billing. Get one at
# https://console.anthropic.com/settings/keys. Must be set as a Vercel
# Environment Variable (not just here) for api/search.py to use it at
# request time. Without it, the Search tool falls back to a simpler
# regex-based keyword expansion -- it still works, just less expert.
# Status: set in Vercel Environment Variables.
ANTHROPIC_API_KEY=
